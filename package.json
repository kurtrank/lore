{
  "name": "lore",
  "version": "1.3.1",
  "description": "WordPress project to help manage content types and fields",
  "main": "index.js",
  "scripts": {
    "build": "wp-scripts build",
    "start": "wp-scripts start",
    "test": "echo \"Error: no test specified\" && exit 1",
    "generate-zip": "node node_modules/wp-release/release-prep.js",
    "test-release": "semantic-release --dry-run",
    "release": "semantic-release"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kurtrank/lore.git"
  },
  "author": "Kurt Rank",
  "bugs": {
    "url": "https://github.com/kurtrank/lore/issues"
  },
  "homepage": "https://github.com/kurtrank/lore#readme",
  "devDependencies": {
    "@humanmade/block-editor-components": "^0.10.0",
    "@wordpress/scripts": "^31.2.0",
    "wp-release": "github:risepoint/wp-release"
  },
  "dependencies": {
    "@wordpress/icons": "^11.4.0"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    },
    "wpRelease": {
      "ignore": [
        ".editorconfig",
        ".DS_Store",
        ".git/**",
        ".github/**",
        ".gitignore",
        ".npm/**",
        "node_modules/**",
        "src/**"
      ]
    }
  },
  "release": {
    "extends": "wp-release",
    "branches": [
      "main",
      {
        "name": "beta",
        "prerelease": true
      }
    ]
  }
}